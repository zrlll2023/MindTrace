{
  "name": "mindtrace",
  "version": "0.2.0",
  "description": "MindTrace —— 本地优先的个人生活记录与 AI 分析桌面应用",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "mock": "node scripts/mock-llm-server.mjs",
    "dev:main": "tsc -p tsconfig.node.json && electron .",
    "build": "vite build && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "dist": "pnpm build && electron-builder --win"
  },
  "author": "zrlll2023",
  "license": "MIT",
  "build": {
    "appId": "com.zrlll2023.mindtrace",
    "productName": "MindTrace",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MindTrace"
    }
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "fflate": "^0.8.3",
    "marked": "^18.0.13",
    "pinia": "^4.0.3",
    "sql.js": "^1.14.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.5.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
    "wait-on": "^9.1.0"
  }
}
